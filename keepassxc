# upstream issue #13865: browser get-logins by path or uuid crashes when the
# matched entry has no URL and no additional URLs (BrowserService::sortPriority
# dereferences an empty priorityList). keepassxc.files holds the source guard
# that the patched prepare() applies.
patch#pkgbuild#../keepassxc.patches/pkgbuild-13865.patch

# add +icedream.1 to final package version without disturbing the script
replace#global#^pkgver=#_orig_pkgver=
replace#global#$pkgver#\$_orig_pkgver
replace#global#${pkgver}#\${_orig_pkgver}
addline#global#_orig_pkgver=#pkgver=\${_orig_pkgver}+icedream.1
